// Grammar for kBlockDB's query language -- see lib.rs's doc comment for
// the four statement kinds and docs/query-language.md (at the repository
// root) for worked examples. Parsed with pest (https://pest.rs); lib.rs
// walks the resulting parse tree into this crate's typed AST.

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Keywords are case-insensitive (`^"..."`) but must end at a word boundary
// -- without the trailing negative lookahead, "SELECT" would also match
// the first six letters of a column named "selection". These are atomic
// (`@{ }`), not silent (`_{ }`): a silent-but-non-atomic rule would let
// pest's implicit whitespace skip run *before* the lookahead, so the
// lookahead would end up checking the first character of whatever comes
// *after* the following whitespace instead of the character right after
// the keyword itself -- silently breaking the boundary check for every
// keyword followed by a space (i.e. every realistic query). Being atomic
// means these show up as their own pairs in the parse tree (a plain
// silent rule's pairs get suppressed instead) -- lib.rs's tree-walking
// code explicitly skips `Rule::kw_*` pairs to account for that.
kw_select = @{ ^"SELECT" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_set    = @{ ^"SET"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_update = @{ ^"UPDATE" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_delete = @{ ^"DELETE" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_from   = @{ ^"FROM"   ~ !(ASCII_ALPHANUMERIC | "_") }
kw_where  = @{ ^"WHERE"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_in     = @{ ^"IN"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_to     = @{ ^"TO"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_and    = @{ ^"AND"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_or     = @{ ^"OR"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_not    = @{ ^"NOT"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_exists = @{ ^"EXISTS" ~ !(ASCII_ALPHANUMERIC | "_") }
// Metadata keywords -- see `meta` below: these address a cell's
// per-key `CellMeta` fields (`created_at_ms`/`modified_at_ms`/`version`)
// from a WHERE clause, the same word-bounded, case-insensitive way every
// other keyword here does.
kw_created = @{ ^"CREATED" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_updated = @{ ^"UPDATED" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_version = @{ ^"VERSION" ~ !(ASCII_ALPHANUMERIC | "_") }

statement = { SOI ~ (select_stmt | set_stmt | update_stmt | delete_stmt) ~ EOI }

select_stmt = { kw_select ~ columns ~ (kw_from ~ range)? ~ (kw_where ~ expr)? }
// SET is an upsert over `IN <range>` -- unlike UPDATE, it can create cells
// that don't exist yet, so a range is mandatory: "upsert everywhere" isn't
// a meaningful request. See this crate's doc comment.
set_stmt    = { kw_set ~ "(" ~ assignment_list ~ ")" ~ (kw_where ~ expr)? ~ kw_in ~ range }
// UPDATE only ever touches cells that already exist (it's built on
// World::list_cells, same as SELECT/DELETE) -- its range is optional, same
// as DELETE's.
update_stmt = { kw_update ~ "(" ~ assignment_list ~ ")" ~ (kw_where ~ expr)? ~ (kw_in ~ range)? }
delete_stmt = { kw_delete ~ (kw_where ~ expr)? ~ (kw_in ~ range)? }

// Aggregates are tried first: `count(*)`/`sum(key)`/... need their "("
// checked before `column_list` could mistake the function name alone
// (e.g. "count") for a plain column -- same "the paren disambiguates"
// trick `now_call` (see `literal` below) already relies on, so no
// separate word-boundary keyword is needed here either. Without a
// preceding paren, e.g. bare `SELECT count`, this alternative simply
// fails to match and `column_list` picks it up as an ordinary key name.
columns         = { aggregate_list | "*" | column_list }
column_list     = { ident ~ ("," ~ ident)* }
aggregate_list  = { aggregate_call ~ ("," ~ aggregate_call)* }
aggregate_call  = { count_call | sum_call | mean_call | max_call | min_call }
count_call      = { ^"COUNT" ~ "(" ~ "*" ~ ")" }
sum_call        = { ^"SUM"  ~ "(" ~ ident ~ ")" }
mean_call       = { ^"MEAN" ~ "(" ~ ident ~ ")" }
max_call        = { ^"MAX"  ~ "(" ~ ident ~ ")" }
min_call        = { ^"MIN"  ~ "(" ~ ident ~ ")" }

assignment_list = { assignment ~ ("," ~ assignment)* }
assignment      = { ident ~ "=" ~ literal }

// An axis-aligned box: `from` inclusive, `to` exclusive on every axis (same
// convention as kblockdblib::Region -- see this crate's `Range`). Each
// component is a signed `int` (see below), not just digits, since a range
// can sit anywhere in a world's now zero-centered coordinate space.
range = { point ~ kw_to ~ point }
point = { "(" ~ int ~ ("," ~ int)* ~ ")" }

expr      = { or_expr }
or_expr   = { and_expr ~ (kw_or ~ and_expr)* }
and_expr  = { not_expr ~ (kw_and ~ not_expr)* }
not_expr  = { kw_not ~ not_expr | primary }
primary   = { "(" ~ expr ~ ")" | exists | comparison }

// Whether a key is set at a cell at all, regardless of its value or type --
// `EXISTS(density)`. Always a plain key name, never `x<N>`: every cell has
// every axis coordinate, so "does this axis exist" isn't a meaningful
// question the way "is this key set" is.
exists = { kw_exists ~ "(" ~ ident ~ ")" }

comparison = { operand ~ compare_op ~ literal }
// `x0`, `x1`, ... addresses a coordinate axis by index; `created`/
// `updated`/`version` address a cell's metadata (see `meta`); anything
// else is a key name. A key literally named e.g. "x0", "created",
// "updated", or "version" can't be addressed this way -- a known,
// documented limitation of a generic axis-count grammar, extended here to
// the metadata keywords too.
operand    = { axis | meta | ident }
axis       = @{ "x" ~ ASCII_DIGIT+ }
// A cell's per-key metadata, addressed by keyword in a WHERE clause --
// `created`/`updated` are millisecond timestamps, `version` an overwrite
// counter (see `kblockdblib::CellMeta`). Checked ahead of `ident` in
// `operand` so these take priority the same way every other keyword here
// does.
meta       = { kw_created | kw_updated | kw_version }
compare_op = { "!=" | "<=" | ">=" | "=" | "<" | ">" }

literal  = { string | float | int | bool_lit | now_call }
// `now()` -- the current time in milliseconds since the Unix epoch, same
// units as `created`/`updated`. No word-boundary lookahead needed (unlike
// the `kw_*` keywords above): the mandatory "(" immediately after "NOW"
// already can't appear in a bare identifier, so a key named e.g. "nowish"
// never collides with this.
now_call = @{ ^"NOW" ~ "(" ~ ")" }
string   = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
float    = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
int      = @{ "-"? ~ ASCII_DIGIT+ }
// Case-insensitive and word-bounded, same as the statement keywords above
// (`^"TRUE"` alone would also match the first four letters of a key named
// "truex").
bool_lit = @{ (^"true" | ^"false") ~ !(ASCII_ALPHANUMERIC | "_") }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
