// Grammar for kBlockDB's query language -- see query.rs's doc comment for
// the three statement kinds and README's "Query language" section for
// worked examples. Parsed with pest (https://pest.rs); `query.rs` walks
// the resulting parse tree into this module's typed AST.

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Keywords are case-insensitive (`^"..."`) but must end at a word boundary
// -- without the trailing negative lookahead, "SELECT" would also match
// the first six letters of a column named "selection". These are atomic
// (`@{ }`), not silent (`_{ }`): a silent-but-non-atomic rule would let
// pest's implicit whitespace skip run *before* the lookahead, so the
// lookahead would end up checking the first character of whatever comes
// *after* the following whitespace instead of the character right after
// the keyword itself -- silently breaking the boundary check for every
// keyword followed by a space (i.e. every realistic query). Being atomic
// means these show up as their own pairs in the parse tree (a plain
// silent rule's pairs get suppressed instead) -- query.rs's tree-walking
// code explicitly skips `Rule::kw_*` pairs to account for that.
kw_select = @{ ^"SELECT" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_set    = @{ ^"SET"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_update = @{ ^"UPDATE" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_delete = @{ ^"DELETE" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_from   = @{ ^"FROM"   ~ !(ASCII_ALPHANUMERIC | "_") }
kw_where  = @{ ^"WHERE"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_in     = @{ ^"IN"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_to     = @{ ^"TO"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_and    = @{ ^"AND"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_or     = @{ ^"OR"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_not    = @{ ^"NOT"    ~ !(ASCII_ALPHANUMERIC | "_") }

statement = { SOI ~ (select_stmt | set_stmt | update_stmt | delete_stmt) ~ EOI }

select_stmt = { kw_select ~ columns ~ (kw_from ~ range)? ~ (kw_where ~ expr)? }
// SET is an upsert over `IN <range>` -- unlike UPDATE, it can create cells
// that don't exist yet, so a range is mandatory: "upsert everywhere" isn't
// a meaningful request. See query.rs's doc comment.
set_stmt    = { kw_set ~ "(" ~ assignment_list ~ ")" ~ (kw_where ~ expr)? ~ kw_in ~ range }
// UPDATE only ever touches cells that already exist (it's built on
// World::list_cells, same as SELECT/DELETE) -- its range is optional, same
// as DELETE's.
update_stmt = { kw_update ~ "(" ~ assignment_list ~ ")" ~ (kw_where ~ expr)? ~ (kw_in ~ range)? }
delete_stmt = { kw_delete ~ (kw_where ~ expr)? ~ (kw_in ~ range)? }

columns     = { "*" | column_list }
column_list = { ident ~ ("," ~ ident)* }

assignment_list = { assignment ~ ("," ~ assignment)* }
assignment      = { ident ~ "=" ~ literal }

// An axis-aligned box: `from` inclusive, `to` exclusive on every axis (same
// convention as kblockdblib::Region -- see query.rs's `Range`). Each
// component is a signed `int` (see below), not just digits, since a range
// can sit anywhere in a world's now zero-centered coordinate space.
range = { point ~ kw_to ~ point }
point = { "(" ~ int ~ ("," ~ int)* ~ ")" }

expr      = { or_expr }
or_expr   = { and_expr ~ (kw_or ~ and_expr)* }
and_expr  = { not_expr ~ (kw_and ~ not_expr)* }
not_expr  = { kw_not ~ not_expr | primary }
primary   = { "(" ~ expr ~ ")" | comparison }

comparison = { operand ~ compare_op ~ literal }
// `x0`, `x1`, ... addresses a coordinate axis by index; anything else is a
// key name. A key literally named e.g. "x0" can't be addressed this way --
// a known, documented limitation of a generic axis-count grammar.
operand    = { axis | ident }
axis       = @{ "x" ~ ASCII_DIGIT+ }
compare_op = { "!=" | "<=" | ">=" | "=" | "<" | ">" }

literal = { string | float | int }
string  = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
float   = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
int     = @{ "-"? ~ ASCII_DIGIT+ }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
