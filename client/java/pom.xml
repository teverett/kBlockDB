<?xml version="1.0" encoding="UTF-8"?>
<!--
  A Java client for kBlockDB's binary protocol (see
  kblockdbserver/src/wire.rs and the root README's "Binary protocol"
  section for the wire format itself). `mvn package` produces
  target/kblockdb-client-<version>.jar; no runtime dependencies, so that
  jar is exactly the client's own compiled classes.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kblockdb</groupId>
  <artifactId>kblockdb-client</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>kBlockDB Java Client</name>
  <description>A Java client for kBlockDB's binary protocol.</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Test-only: none of this ends up in the packaged jar. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Every compile warning is treated as an error, per the
               root AGENTS.md's "Always fix all compile warnings". -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
